# App login — subject to row-level security. Never the superuser.
DATABASE_URL=postgresql+asyncpg://esl_app_dev:esl_app_dev@localhost:5433/esl
# Owner login — migrations and admin tasks only.
ADMIN_DATABASE_URL=postgresql+asyncpg://esl:esl@localhost:5433/esl
REDIS_URL=redis://localhost:6380/0
SQUARE_TOKEN=<sandbox-token>
SQUARE_ENVIRONMENT=SANDBOX
SQUARE_WEBHOOK_SIGNATURE_KEY=<from Square Developer Dashboard → Webhooks → signature key>
SQUARE_WEBHOOK_URL=https://<your-domain>/v1/webhooks/square
# Dashboard sign-in (scripts/dev_cognito.ps1 prints these). Empty = sign-in off (API answers 503).
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
